# ── Supabase (optional) ────────────────────────────────────────────────
# Leave these empty to run in local demo mode: pages and photos are stored
# in the .data/ folder on this machine. Perfect for trying things out.
#
# To go live: create a free project at https://supabase.com, run
# supabase/schema.sql in the SQL editor, then paste your values below.
# Use the SECRET key (settings → API keys), never the publishable one.

SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Older projects use these names instead — either works.
# SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for share links in emails/copy. Optional.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
